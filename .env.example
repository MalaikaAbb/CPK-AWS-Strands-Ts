# CopilotKit + AWS Strands (TypeScript) test suite
#
# Copy this file twice — the two processes read their own environment:
#
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local
#
# Only OPENAI_API_KEY is required. Everything else has a working default.

# ---------------------------------------------------------------- required

# Model provider key. Used by the agent server for every run, and by the
# frontend's voice runtime for Whisper transcription.
# Without it the backend starts and every run fails at the model call.
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------- backend

# The model every agent is built with.
#
# Defaults to gpt-4o. The Quickstart's code block says `modelId: "gpt-5.4"`,
# which is not a model OpenAI serves — its own callout two lines down says the
# example "uses OpenAI's GPT-4o", and both Shared State pages use gpt-4o.
# Set this to gpt-5.4 to reproduce the failure the doc would give you.
MODEL_ID=gpt-4o

# Port the agent server listens on. The frontend's AGENT_URL must agree.
PORT=8000

# ---------------------------------------------------------------- frontend

# Where the frontend's Copilot Runtime reaches the agent server. Each agent is
# mounted at /{agent-id}, so the AG-UI root for one agent is
# ${AGENT_URL}/{agent-id}/ — with the trailing slash.
AGENT_URL=http://localhost:8000

# CopilotKit Intelligence licence key, from dashboard.operations.copilotkit.ai.
#
# Optional. With it, the runtime enables persistent Threads and the Inspector
# and scopes threads per user via `identifyUser`. Without it the runtime drops
# both options and falls back to SSE with an in-memory runner — chat still
# works, Threads and the Inspector stay locked. That fallback is the
# Quickstart's own documented behaviour, not a workaround.
# INTELLIGENCE_API_KEY=your_license_key

# Set to `off` to disable the CopilotKit inspector on every route.
# Leave unset for the package default (localhost only).
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off
